rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      // Let's not allow write on user profile if not needed, or just basic write
      allow write: if isOwner(userId);

      match /searches/{searchId} {
        allow read: if isOwner(userId);
        
        function isValidSearchQuery(data) {
          return data.keys().hasAll(['userId', 'query', 'symbol', 'result', 'createdAt']) &&
                 data.keys().size() == 5 &&
                 data.userId is string && data.userId == request.auth.uid &&
                 data.query is string && data.query.size() <= 200 &&
                 data.symbol is string && data.symbol.size() <= 50 &&
                 data.result is string && data.result.size() <= 10000 &&
                 data.createdAt == request.time;
        }

        allow create: if isOwner(userId) && isValidSearchQuery(request.resource.data);
        allow update: if false;
        allow delete: if isOwner(userId);
      }
    }
  }
}
